{
  "name": "@ipthmc/craft-workshop",
  "version": "0.7.0",
  "private": true,
  "description": "方块工坊 CraftWorkshop —— DSH 通用整合包创作插件：多项目管理、模组/插件市场、AI 组合整合包、剧情/任务/人物等设计内容编辑、个性化客户端、FTB Quests/Patchouli/KubeJS 导出、.mrpack 构建与服务端运维，自带 Web 主面板。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/*.js",
    "dev/smoke.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
