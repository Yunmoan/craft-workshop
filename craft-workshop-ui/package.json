{
  "name": "@ipthmc/craft-workshop-ui",
  "version": "0.1.0",
  "private": true,
  "description": "CraftWorkshop（方块工坊）Web UI：在 DSH 设置页中展示整合包工程、设计内容、导出与构建状态。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
